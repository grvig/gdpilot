<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>GDPilot.App</RootNamespace>
    <AssemblyName>GDPilot</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDPilot.Core\GDPilot.Core.csproj" />
    <ProjectReference Include="..\GDPilot.Input\GDPilot.Input.csproj" />
    <ProjectReference Include="..\GDPilot.Output\GDPilot.Output.csproj" />
    <ProjectReference Include="..\GDPilot.Overlay\GDPilot.Overlay.csproj" />
    <ProjectReference Include="..\GDPilot.Vision\GDPilot.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF drops this implicit using to avoid its own Path type; the host uses only the file system one. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\game-functions.txt" Link="game-functions.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Built separately by src\GDPilot.InGame\build.cmd; copied along when present. -->
    <None Include="..\GDPilot.InGame\bin\GDPilot.InGame.dll" Link="GDPilot.InGame.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GDPilot.InGame\bin\GDPilot.InGame.dll')" />
  </ItemGroup>

</Project>
