<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Brings in System.Drawing for an independent reference capture. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GDPilot.Output\GDPilot.Output.csproj" />
    <ProjectReference Include="..\..\src\GDPilot.Vision\GDPilot.Vision.csproj" />
    <ProjectReference Include="..\..\src\GDPilot.Input\GDPilot.Input.csproj" />
    <ProjectReference Include="..\..\src\GDPilot.Overlay\GDPilot.Overlay.csproj" />
    <!-- Referenced so the host executable is built and copied beside the tests that start it. -->
    <ProjectReference Include="..\..\src\GDPilot.App\GDPilot.App.csproj" />
    <!-- The tests launch this executable, and a full reference is what copies its assembly alongside the launcher. -->
    <ProjectReference Include="..\..\src\GDPilot.Loopback\GDPilot.Loopback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- WPF drops this implicit using to avoid its own Path type; these tests use only the file system one. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\traces\*.json" LinkBase="traces" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\screens\*.png" LinkBase="screens" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\screens\occupancy.txt" LinkBase="screens" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
